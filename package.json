{
  "name": "@ihopeyoucanfly/aurora-ui",
  "version": "0.1.0",
  "description": "Aurora UI — accessible React components built with Radix primitives",
  "homepage": "https://github.com/dshishkin3/Aurora-UI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dshishkin3/Aurora-UI.git"
  },
  "bugs": {
    "url": "https://github.com/dshishkin3/Aurora-UI/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run tests/a11y.test.tsx",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:visual": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run pack:check && npm run verify:consumer"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.54.2",
    "@eslint/js": "^9.32.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@testing-library/react": "^16.3.0",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/react-vite": "9.1.20",
    "storybook": "9.1.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.39.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
